# App
NODE_ENV=development
PORT=3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# First admin (created on boot if the admins table is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Hosted Postgres only — no local database container.
# Include sslmode=require for most cloud providers (Neon, Supabase, RDS).
DATABASE_URL=postgresql://user:password@host:5432/dreamview?sslmode=require

# S3-compatible object storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, …)
S3_BUCKET=dreamview-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL used to serve images (R2 custom domain, CloudFront, or virtual-host S3 URL)
S3_PUBLIC_URL=https://media.example.com
# Required for R2 / Spaces / MinIO. Leave empty for AWS S3.
# R2 example: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Set true for R2, Spaces, MinIO
S3_FORCE_PATH_STYLE=false
