# App
NODE_ENV=development
PORT=3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# First admin (created on boot if the admins table is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Hosted Postgres only — no local database container.
# Include sslmode=require for most cloud providers (Neon, Supabase, RDS).
DATABASE_URL=postgresql://user:password@host:5432/dreamview?sslmode=require

# Cloudinary (Dashboard → Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# External cron (Render keep-awake + scheduled publish). Generate with: openssl rand -hex 32
CRON_SECRET=
